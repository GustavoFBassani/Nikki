    "NSHandsTrackingUsageDescription" : {
      "comment" : "Alerta de permissão de rastreamento das mãos (visionOS).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use hand tracking so you can interact with the scene and fold your origami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos o rastreamento das mãos para você interagir com a cena e dobrar seus origamis."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Alerta de permissão de localização. Usada só para consultar o clima da região no WeatherKit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use your location to match the scene's weather to your region."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos sua localização para deixar o clima do cenário igual ao da sua região."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Alerta de permissão do microfone. Usada pelo AudioRecorder para gravar áudios anexados às páginas.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use the microphone to record audio notes and attach them to your pages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos o microfone para gravar áudios e anexá-los às suas páginas."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Alerta de permissão de escrita na galeria. Usada pelo ShareService ao salvar a página exportada.",
