                over "DomeMAT"
                {
                    float inputs:clearcoat = 0
                    float inputs:clearcoat.connect = </Root/SkyDome/Looks/DomeMATSG/clearcoat.outputs:r>
                    color3f inputs:diffuseColor.connect = </Root/SkyDome/Looks/DomeMATSG/diffuseColor.outputs:rgb>
                    color3f inputs:emissiveColor = (1, 1, 1) (
                        colorSpace = "srgb_displayp3"
                    )
                    color3f inputs:emissiveColor.connect = </Root/SkyDome/Looks/DomeMATSG/emissiveColor.outputs:rgb>
                }

                over "emissiveColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @aaaaaaaa.png@
                }

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @artefinalfundo_upscaled.png@
                    float2 inputs:st.connect = </Root/SkyDome/Looks/DomeMATSG/diffuseColor/TexCoordReader.outputs:result>
                    color3f outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/SkyDome/Looks/DomeMATSG.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                def Shader "clearcoat"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @artefinalfundo_upscaled.png@
                    float2 inputs:st.connect = </Root/SkyDome/Looks/DomeMATSG/clearcoat/TexCoordReader.outputs:result>
                    float outputs:r

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/SkyDome/Looks/DomeMATSG.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }
            }

            over "GroundMATSG"
            {
                over "GroundMAT"
                {
                    color3f inputs:diffuseColor = (1, 1, 1) (
                        colorSpace = "lin_srgb"
                    )
                    color3f inputs:emissiveColor = (1, 1, 1) (
                        colorSpace = "lin_srgb"
                    )
                    delete color3f inputs:emissiveColor.connect = </Root/SkyDome/Looks/GroundMATSG/file4.outputs:rgb>
                    float inputs:opacity = 0
                }
            }
        }
    }

    over "Material"
